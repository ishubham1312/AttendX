<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Section: Status and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_status_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_pending" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Attendance Pending"
                    android:textColor="#090F16"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Tap to mark attendance"
                    android:textColor="#6E7582"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider line -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#F1F5F9" />

        <!-- Bottom Section: Date and Action/Stat -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif"
                android:text="June 05, 2026"
                android:textColor="#6E7582"
                android:textSize="11sp" />

            <!-- Subtitle/Score (e.g. Attendance • 100%) -->
            <TextView
                android:id="@+id/widget_bottom_right_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:text="Attendance • 100%"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Calendar icon as fallback or alternative -->
            <ImageView
                android:id="@+id/widget_bottom_right_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_widget_calendar"
                android:visibility="visible" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
